# Jarvis Watch Bridge 配置模板 — 复制为 .env 使用
# 通常直接运行: python3 setup.py 自动生成

# 访问令牌: iPhone 快捷指令请求头 X-Jarvis-Key 的值 (setup.py 自动生成强随机值)
JARVIS_TOKEN=

# 推理服务选择: auto=有GLM密钥用glm, 否则demo | glm | demo
PROVIDER=auto

# GLM 通用 API (角色B, 日常问答)
# 注意: GLM Coding Plan 编程接口不得用于此处; 请使用通用 API 密钥
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_TIMEOUT=45

# 服务绑定: 只监听本机回环地址, 公网访问经 Cloudflare Tunnel 转发
HOST=127.0.0.1
PORT=8765

# Voicenotes 个人记忆 (v0.2): 令牌由 python3 voicenotes_oauth.py 浏览器授权后自动写入
VOICENOTES_ACCESS_TOKEN=
VOICENOTES_ENABLED=auto
VOICENOTES_ENDPOINT=https://api.voicenotes.com/mcp
VOICENOTES_TIMEOUT=20

# 输入限制: 单个问题的最大字符数 (超出返回400)
MAX_QUESTION_CHARS=500
